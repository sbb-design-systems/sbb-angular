{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "username": "sbb-angular-renovate[bot]",
  "gitAuthor": "sbb-angular-renovate<100206640+sbb-angular-renovate[bot]@users.noreply.github.com>",
  "repositories": ["sbb-design-systems/sbb-angular"],
  "baseBranchPatterns": ["main", "22.x"],
  "includePaths": ["package.json", ".github/**", "pnpm-lock.yaml", "pnpm-workspace.yaml"],
  "timezone": "Europe/Zurich",
  "lockFileMaintenance": {
    "schedule": ["before 7am on thursday"],
    "enabled": true
  },
  "allowedCommands": ["^pnpm"],
  "ignoreDeps": [
    "@angular/bazel",
    "@types/marked",
    "@types/minimatch",
    "@types/yargs",
    "rollup",
    "@rollup/plugin-commonjs",
    "@rollup/plugin-node-resolve",
    "browser-sync",
    "browser-sync-client",
    "dgeni",
    "dgeni-packages",
    "highlight.js",
    "marked",
    "minimatch",
    "typescript",
    "zone.js"
  ],
  "skipInstalls": false,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "lockFileMaintenance", "bump"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchPackageNames": ["@types/grecaptcha", "@types/node", "jasmine", "jasmine-core"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["node"],
      "allowedVersions": "<=22"
    },
    {
      "groupName": "angular",
      "matchPackageNames": [
        "@angular/{/,}**",
        "@angular-devkit/{/,}**",
        "@schematics/angular{/,}**",
        "typescript{/,}**"
      ]
    },
    {
      "groupName": "bazel",
      "matchPackageNames": ["@bazel/{/,}**"]
    },
    {
      "groupName": "commitlint",
      "matchPackageNames": ["@commitlint/{/,}**", "standard-version{/,}**"]
    },
    {
      "groupName": "rollup",
      "matchPackageNames": ["@rollup/{/,}**", "rollup{/,}**"]
    },
    {
      "groupName": "karma",
      "matchPackageNames": ["karma{/,}**"]
    },
    {
      "groupName": "jasmine",
      "matchPackageNames": ["jasmine{/,}**", "@types/jasmine{/,}**"]
    },
    {
      "matchPackageNames": ["@angular/cli", "@angular/cdk", "angular-server-side-configuration"],
      "postUpgradeTasks": {
        "commands": [
          "pnpm install --ignore-scripts --frozen-lockfile",
          "pnpm ng update {{{depName}}} --from={{{currentVersion}}} --to={{{newVersion}}} --migrate-only --allow-dirty --force",
          "pnpm format"
        ],
        "fileFilters": ["**/**"]
      }
    },
    {
      "matchPackageNames": ["prettier"],
      "postUpgradeTasks": {
        "commands": ["pnpm install --ignore-scripts --frozen-lockfile", "pnpm format:prettier"],
        "fileFilters": ["**/**"]
      }
    },
    {
      "matchPackageNames": ["esbuild"],
      "postUpgradeTasks": {
        "commands": [
          "pnpm install --ignore-scripts --frozen-lockfile",
          "pnpm build:schematics",
          "pnpm format"
        ],
        "fileFilters": ["**/**"]
      }
    },
    {
      "matchPackageNames": ["renovate"],
      "extends": ["schedule:monthly"]
    },
    {
      "matchPackageNames": ["@angular/dev-infra", "@angular/ng-dev"],
      "groupName": "angular shared dev-infra code",
      "schedule": ["before 5am on wednesday"]
    }
  ]
}
